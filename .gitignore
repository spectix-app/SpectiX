# Build outputs (regenerated by build.sh / package.sh)
SpectiX.app/
# The dev build's bundle. Named apart from the release one on purpose: System
# Settings labels its privacy rows by file name, and two SpectiX.app's leave no
# way to tell which Accessibility switch belongs to which. See build.sh.
SpectiX Dev.app/
# Pre-T172 name. Kept so a working copy built before the rename doesn't show the
# stale bundle as untracked; drop it once none is left. (gitignore has no inline
# comments — a trailing "#" would become part of the pattern.)
TaskBeacon.app/
*.zip
# What the release zip unpacks into when you check it by hand. package.sh builds
# its own copy under mktemp, so a folder by this name in the repo root is always
# a local artifact.
SpectiX-*/
build/
DerivedData/

# macOS
.DS_Store

# Local editor / Claude state
.claude/settings.local.json
.vscode/
*.xcuserstate
# Not a product name — this is the state dir of the global /task tool
# (~/.claude/bin/todo.py hardcodes ".taskbeacon"). T172 renamed the app, not that
# tool, so this pattern must NOT follow the rename: doing so unignores
# task/.taskbeacon/ (todos.json, locks, logs) straight into the repo.
.taskbeacon/
task/todo-view.md
task/files/todo.py
task/config.json
task/todo-archived.md
.build.lock
